# Pre-commit gate — runs prettier on staged files only (lint-staged in
# package.json: `*.{ts,tsx,css,md,json}` -> `prettier --write`, and nothing
# else — eslint was deliberately taken out in 9a3923e because it blocked
# commits on pre-existing issues; it stays a manual gate via `npm run lint`,
# see AUDIT_PIATTAFORMA_COACH.md:104), then the lockfile/npm pin check below,
# then a project-wide `tsc --noEmit -p tsconfig.app.json` to catch any
# cross-file type regressions before they land in main.

npx lint-staged || exit 1
# A lockfile is only valid under the npm version that wrote it. CI reads
# it with the exact version declared in `packageManager` (see the
# "Inchioda npm" step in .github/workflows/ci.yml), so writing it with
# any other version is refused here — before it can reach a PR.
if git diff --cached --name-only | grep -qx "package-lock.json"; then
  WANTED=$(node -p "(String(require('./package.json').packageManager||'').match(/npm@([0-9][^+]*)/)||[])[1]||''")
  GOT=$(npm --version)
  if [ -z "$WANTED" ] || [ "$GOT" != "$WANTED" ]; then
    echo "package-lock.json nel commit, ma npm locale ($GOT) != packageManager ($WANTED)." >&2
    echo "Rigenera il lockfile con la versione dichiarata: npx -y npm@$WANTED install --package-lock-only" >&2
    exit 1
  fi
fi
# `tsc --noEmit` without `-p` is a no-op when the root tsconfig has empty
# `files` + project references (our setup), so use the app project file
# explicitly. Otherwise type errors slip through unnoticed.
npx tsc --noEmit -p tsconfig.app.json || exit 1
