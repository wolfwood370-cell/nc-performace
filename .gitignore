# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env reali: MAI tracciati. Il template coi soli nomi vive in .env.example.
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code session/agent artifacts (worktrees, local settings, hooks).
# Anything inside .claude/ is per-session state and must not be committed,
# EXCEPT methodology/, agents/, hooks/ and settings.json (versioned config).
.claude/*
!.claude/methodology/
!.claude/methodology/**
!.claude/agents/
!.claude/agents/**
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json

# Lint baseline snapshot — regenerated locally with `npm run lint > LINT_BASELINE.txt`.
# Tracking it in git would generate noisy diffs on every lint-config change.
LINT_BASELINE.txt

# Husky internal runtime — regenerated by the `prepare` script on npm install.
# Only the user-defined hooks (pre-commit, pre-push, ...) are committed.
.husky/_

# Playwright E2E — artefatti generati (report HTML, trace, screenshot dei test).
test-results/
playwright-report/
# Storage-state autenticato per gli E2E (può contenere un token di sessione reale).
e2e/.auth/
supabase/.temp/linked-project.json
